# Okta org URL. Used as the SET `aud` and to build the push endpoint.
# No trailing slash and no /oauth2/default.
OKTA_ORG_URL=https://your-org.okta.com

# Persistent RS256 private key (PKCS#8 PEM). Generate with `npm run genkey`.
# Required on Railway: without it the key (and JWKS) changes on every deploy.
SIGNING_KEY_PEM=

# Password for the console and /api/events (HTTP Basic, any username).
ADMIN_PASSWORD=change-me

# Optional overrides
# PUBLIC_URL=https://ssf-transmitter.up.railway.app   # defaults to https://$RAILWAY_PUBLIC_DOMAIN
# SSF_ISSUER=https://ssf-transmitter.up.railway.app   # defaults to PUBLIC_URL; must match Okta's provider issuer
# SET_AUDIENCE=https://your-org.okta.com              # defaults to OKTA_ORG_URL
# OKTA_SET_ENDPOINT=https://your-org.okta.com/security/api/v1/security-events
# SIGNING_KEY_ID=ssf-demo-key-1                        # defaults to the JWK thumbprint
# DEFAULT_SUBJECT_EMAIL=demo.user@example.com          # pre-fills the console form
