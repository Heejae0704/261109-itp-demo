# Okta org URL (no trailing slash)
OKTA_ORG_URL=https://your-org.okta.com

# OIDC issuer. Leave unset to use the org authorization server (recommended for this demo).
# OKTA_ISSUER=https://your-org.okta.com

# From the Okta OIDC Web Application
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Random string for signing cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: defaults to https://$RAILWAY_PUBLIC_DOMAIN or http://localhost:3000
# APP_BASE_URL=https://acme-portal.up.railway.app

# Set to false only to debug a first integration: logs a bad Universal Logout JWT instead of rejecting it
# STRICT_LOGOUT_AUTH=true
